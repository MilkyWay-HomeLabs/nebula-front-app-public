# Router base path for BrowserRouter basename
# Example for root: /
# Example for subpath: /nebula-home/
VITE_PUBLIC_URL=/

# App API and auth config used by src/data/Credentials.js
VITE_REQUEST_URL=https://api.example.com
VITE_USERNAME=demo-user
VITE_PASSWORD=demo-pass
VITE_TOMCAT_DOMAIN=https://example.com:8555
VITE_APACHE_DOMAIN=https://example.com
VITE_RESOURCES_DOMAIN=https://example.com/resources/
PLAYWRIGHT_IGNORE_HTTPS=1
PLAYWRIGHT_BASE_URL=https://milkyway.test/dev/nebula/app/
# Enable a single POST probe to prime CSRF cookie when the backend only
# issues XSRF-TOKEN in responses to mutating requests. Set to 'true' in
# development if you observe login requiring a second attempt. Default: false
VITE_CSRF_PROBE=false

# --- ci/hub-report.sh -------------------------------------------------------------------
#
# Also stored as GitHub Actions repo secrets (Settings -> Secrets and variables -> Actions)
# for the real "Report to Hub" CI step -- these three are the only genuinely sensitive
# values in this file (the HUB_CI_TOKEN), copied here only for a local dry run of
# ci/hub-report.sh.

# Not sensitive on its own -- the Hub's public HTTPS address, reachable from the self-hosted
# test runner the same way a browser reaches it.
#HUB_URL=https://milkyway.test/hub

# Component bearer token for nebula/front/nebula-front-app.
# Mint it from the Hub UI: component screen -> "API tokens" button (shown once on
# creation), or POST /api/v1/components/{id}/tokens. Never share the real value.
#HUB_CI_TOKEN=hubci_replace_with_a_real_token

# milkyway.test's cert is self-signed -- pin it instead of curl -k.
#HUB_CACERT=/home/wolf/MilkyWayHomeLab/infrastructure/docker/test/traefik/certs/milkyway.crt
